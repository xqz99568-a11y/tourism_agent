{
  "schema_version": "ctp-benchmark-v1",
  "dataset_id": "ctp_smoke_test",
  "dataset_version": "2026-07-30",
  "split": "smoke",
  "description": "Small strictly labeled smoke benchmark. Use experiments/ctp120_dev.json for the 20-case development split.",
  "cases": [
    {
      "case_id": "smoke_hangzhou_full_plan",
      "user_input": "Plan a two day Hangzhou trip for two people starting 2026-08-01. Include attractions, weather, itinerary, and budget 5000 yuan.",
      "expected": {
        "task_type": "trip_planning",
        "required_tools": ["poi_search", "weather_query", "budget_calculator"],
        "accepted_agent_sets": [["attraction", "weather", "itinerary", "budget"]],
        "accepted_tool_sets": [["poi_search", "weather_query", "budget_calculator"]],
        "hard_constraints": {
          "duration_days": 2,
          "min_attractions": 3,
          "max_pois_per_day": 2,
          "budget_limit": 5000
        }
      }
    },
    {
      "case_id": "smoke_beijing_attractions",
      "user_input": "Recommend only two Beijing indoor attractions. Do not make an itinerary, weather report, or budget.",
      "expected": {
        "task_type": "attraction_recommendation",
        "min_attractions": 2,
        "max_attractions": 2,
        "required_tools": ["poi_search"],
        "accepted_agent_sets": [["attraction"]],
        "accepted_tool_sets": [["poi_search"]]
      }
    },
    {
      "case_id": "smoke_xian_weather",
      "user_input": "Check only the Xian weather forecast for two days from 2026-08-05.",
      "expected": {
        "task_type": "weather_query",
        "required_tools": ["weather_query"],
        "accepted_agent_sets": [["weather"]],
        "accepted_tool_sets": [["weather_query"]]
      }
    },
    {
      "case_id": "smoke_guilin_budget",
      "user_input": "Estimate only a rough budget for a three day Guilin trip for two people. Do not calculate attraction tickets.",
      "expected": {
        "task_type": "budget_query",
        "budget_limit": 4500,
        "required_tools": ["budget_calculator"],
        "accepted_agent_sets": [["budget"]],
        "accepted_tool_sets": [["budget_calculator"]]
      }
    },
    {
      "case_id": "smoke_shenzhen_clarification",
      "user_input": "I want a Shenzhen trip, but I have not decided the travel date, trip length, or budget.",
      "expected": {
        "task_type": "clarification",
        "missing_slots": ["start_date", "duration_days", "budget_amount"],
        "accepted_agent_sets": [[]],
        "accepted_tool_sets": [[]],
        "forbidden_tools": ["poi_search", "weather_query", "budget_calculator"]
      }
    },
    {
      "case_id": "smoke_beijing_duration_change",
      "case_type": "multi_turn",
      "turns": [
        {
          "turn_id": "t1_full_plan",
          "target_turn": false,
          "user_input": "Create a two day Beijing trip for two adults starting 2026-08-15, including attractions, weather, itinerary, and budget 6500 yuan.",
          "expected": {
            "task_type": "trip_planning",
            "required_tools": ["poi_search", "weather_query", "budget_calculator"],
            "accepted_agent_sets": [["attraction", "weather", "itinerary", "budget"]],
            "accepted_tool_sets": [["poi_search", "weather_query", "budget_calculator"]],
            "hard_constraints": {
              "duration_days": 2,
              "min_attractions": 3,
              "max_pois_per_day": 2,
              "budget_limit": 6500
            }
          }
        },
        {
          "turn_id": "t2_extend_duration",
          "target_turn": true,
          "user_input": "Extend this Beijing trip to three days and keep the city, date, people count, and spending level unchanged.",
          "current_slots": {
            "duration_days": 3
          },
          "expected": {
            "task_type": "partial_replan",
            "changed_slots": ["duration_days"],
            "preserved_slots": ["destination", "start_date", "people_count", "budget_level"],
            "required_tools": ["weather_query", "budget_calculator"],
            "accepted_agent_sets": [["weather", "itinerary", "budget"]],
            "accepted_tool_sets": [["weather_query", "budget_calculator"]],
            "hard_constraints": {
              "duration_days": 3,
              "min_attractions": 3,
              "max_pois_per_day": 2
            }
          }
        }
      ]
    },
    {
      "case_id": "smoke_guilin_rain_adjustment",
      "case_type": "multi_turn",
      "turns": [
        {
          "turn_id": "t1_full_plan",
          "target_turn": false,
          "user_input": "Make a two day Guilin nature trip for two people starting 2026-08-19, including attractions, weather, itinerary, and budget 4800 yuan.",
          "expected": {
            "task_type": "trip_planning",
            "required_tools": ["poi_search", "weather_query", "budget_calculator"],
            "accepted_agent_sets": [["attraction", "weather", "itinerary", "budget"]],
            "accepted_tool_sets": [["poi_search", "weather_query", "budget_calculator"]],
            "hard_constraints": {
              "duration_days": 2,
              "min_attractions": 3,
              "max_pois_per_day": 2,
              "budget_limit": 4800
            }
          }
        },
        {
          "turn_id": "t2_rain_day2",
          "target_turn": true,
          "user_input": "The second day in Guilin becomes rainy. Adjust only the affected day and keep the other day and budget unchanged.",
          "current_slots": {
            "weather_scenario": "rain"
          },
          "weather_change": {
            "scenario_type": "rain",
            "affected_days": [2]
          },
          "expected": {
            "task_type": "weather_adjustment",
            "changed_slots": ["weather_scenario"],
            "preserved_slots": ["destination", "start_date", "duration_days", "people_count", "budget_level"],
            "required_tools": ["weather_query"],
            "accepted_agent_sets": [["weather", "itinerary"]],
            "accepted_tool_sets": [["weather_query"]],
            "weather_change": {
              "scenario_type": "rain",
              "affected_days": [2]
            },
            "hard_constraints": {
              "duration_days": 2,
              "min_attractions": 3,
              "max_pois_per_day": 2,
              "weather_adjustment_required": true
            }
          }
        }
      ]
    },
    {
      "case_id": "smoke_general_chat",
      "user_input": "Hello, no travel planning is needed. I am only testing the assistant.",
      "expected": {
        "task_type": "general_chat",
        "accepted_agent_sets": [[]],
        "accepted_tool_sets": [[]],
        "forbidden_tools": ["poi_search", "weather_query", "budget_calculator"]
      }
    }
  ]
}
