{
  "schema_version": "ctp-evaluation-rule-catalog-v1",
  "catalog_id": "day8_formal_independent_evaluator_rules",
  "frozen_on": "2026-08-19",
  "status_values": [
    "passed",
    "failed",
    "na"
  ],
  "task_types": [
    "trip_planning",
    "attraction_recommendation",
    "weather_query",
    "budget_query",
    "partial_replan",
    "weather_adjustment",
    "clarification",
    "general_chat"
  ],
  "task_aliases": {
    "destination_recommendation": "general_chat",
    "budget_control": "budget_query",
    "attraction_query": "attraction_recommendation",
    "poi_query": "attraction_recommendation",
    "trip_plan": "trip_planning",
    "weather_aware_trip_plan": "trip_planning",
    "weather_forecast_query": "weather_query",
    "weather_climate_question": "general_chat",
    "chat": "general_chat"
  },
  "score_usages": [
    "stsr_gate",
    "hcsr",
    "agent_tool_metric",
    "diagnostic"
  ],
  "metric_rules": {
    "stsr": "passed when all applicable stsr_gate rules pass and no applicable hcsr rule fails",
    "hcsr": "passed applicable hcsr rules / all applicable hcsr rules; na rules are excluded",
    "bpcr": "passed applicable Budget Policy v2.0 rules / all applicable Budget Policy v2.0 rules; na rules are excluded"
  },
  "evaluator_guards": [
    "method_blind",
    "no_llm_or_live_api",
    "no_output_repair",
    "structured_fields_only",
    "append_only_evidence"
  ],
  "rules": [
    {
      "id": "G_SCHEMA_VALID",
      "usage": "stsr_gate",
      "tasks": [
        "*"
      ],
      "inputs": [
        "schema_version",
        "case_id",
        "task_type",
        "execution_status"
      ],
      "passed": "valid unified output",
      "failed": "invalid schema",
      "na": "never",
      "failure_code": "schema_invalid"
    },
    {
      "id": "G_EXECUTION_STATUS_VALID",
      "usage": "stsr_gate",
      "tasks": [
        "*"
      ],
      "inputs": [
        "execution_status",
        "called_tools",
        "trace.tool_calls"
      ],
      "passed": "status matches evidence",
      "failed": "completed despite failed evidence",
      "na": "never",
      "failure_code": "execution_status_incoherent"
    },
    {
      "id": "G_FINAL_ANSWER_CONSISTENT",
      "usage": "stsr_gate",
      "tasks": [
        "*"
      ],
      "inputs": [
        "final_answer",
        "daily_itinerary",
        "attractions",
        "budget",
        "weather",
        "tool_results"
      ],
      "passed": "final text is non-empty and consistent with structured evidence",
      "failed": "empty or contradictory final text",
      "na": "never",
      "failure_code": "final_answer_inconsistent"
    },
    {
      "id": "G_TASK_TYPE_MATCH",
      "usage": "stsr_gate",
      "tasks": [
        "*"
      ],
      "inputs": [
        "gold.task_type",
        "task_type"
      ],
      "passed": "task type matches gold",
      "failed": "wrong task type",
      "na": "never",
      "failure_code": "task_type_mismatch"
    },
    {
      "id": "H_TRIP_DAYS",
      "usage": "hcsr",
      "tasks": [
        "trip_planning",
        "partial_replan",
        "weather_adjustment"
      ],
      "inputs": [
        "gold.duration_days",
        "trip_days",
        "daily_itinerary"
      ],
      "passed": "day count matches",
      "failed": "wrong day count",
      "na": "no duration constraint",
      "failure_code": "trip_days_mismatch"
